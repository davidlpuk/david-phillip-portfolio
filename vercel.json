{
    "buildCommand": "pnpm run build",
    "outputDirectory": "dist/public",
    "installCommand": "npm install -g pnpm@10.4.1 && pnpm install --no-frozen-lockfile",
    "framework": null,
    "trailingSlash": false,
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.ts"
        },
        {
            "source": "/saas",
            "destination": "/saas/index.html"
        },
        {
            "source": "/design-leadership",
            "destination": "/design-leadership/index.html"
        },
        {
            "source": "/cv",
            "destination": "/cv/index.html"
        },
        {
            "source": "/articles",
            "destination": "/articles/index.html"
        },
        {
            "source": "/case-study/coutts",
            "destination": "/case-study/coutts/index.html"
        },
        {
            "source": "/case-study/hsbc-kinetic",
            "destination": "/case-study/hsbc-kinetic/index.html"
        },
        {
            "source": "/case-study/cognism",
            "destination": "/case-study/cognism/index.html"
        },
        {
            "source": "/case-study/ux-sidekick",
            "destination": "/case-study/ux-sidekick/index.html"
        },
        {
            "source": "/(.*)",
            "destination": "/spa.html"
        }
    ],
    "headers": [
        {
            "source": "/js/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/css/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/images/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=604800, stale-while-revalidate=86400"
                }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), microphone=(), geolocation=()"
                }
            ]
        }
    ]
}
